{
  "name": "vscdc-demo",
  "displayName": "VSCGE Dungeon Demo",
  "description": "A minimal movement and combat game using the VSCGE framework",
  "version": "0.1.0",
  "private": true,
  "publisher": "vscge-dev",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "https://github.com/IanMatthewHuff/VSCGE.git" },
  "engines": { "vscode": "^1.96.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "extensionKind": ["ui"],
  "extensionDependencies": ["vscge-dev.vscge"],
  "activationEvents": [],
  "capabilities": { "virtualWorkspaces": true, "untrustedWorkspaces": { "supported": true } },
  "vscge": { "apiVersion": 1, "games": [{ "id": "dungeon", "title": "Dungeon Demo" }] },
  "contributes": {
    "commands": [{ "command": "vscgeDemo.start", "title": "Start Dungeon Demo", "category": "VSCGE" }]
  },
  "dependencies": { "@vscge/engine": "0.1.0" }
}
